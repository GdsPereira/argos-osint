# ==============================================================================
# Configurações do Ambiente - Instagram Analytics Pro & Social Listening Suite
# Copie este arquivo para .env: `copy .env.example .env`
# ==============================================================================

# Tokens de Coleta do Instagram / Meta (Opcionais se fornecidos na interface)
APIFY_TOKEN=
IG_TOKEN=
FB_TOKEN=
IG_USER_ID=

# Configurações do Pipeline Multi-Actor Apify (opcional)
# APIFY_ACTOR=apify/instagram-scraper
# APIFY_COMMENTS_ACTOR=apify/instagram-comments-scraper
# APIFY_STORIES_ACTOR=goat255/instagram-stories-highlights-scraper
# APIFY_HIGHLIGHTS_ACTOR=goat255/instagram-stories-highlights-scraper
# APIFY_ACTOR_TIMEOUT_SECS=90
# APIFY_TIMEOUT_SECS=120

# Configurações de Inteligência Artificial (Opcional)
# AI_PROVIDER: "gemini", "openai", "openrouter", "groq" ou "ollama"
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemma-4-31b-it
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENAI_API_KEY=
AI_BASE_URL=

# Configurações do Banco de Dados PostgreSQL (Docker Compose)
POSTGRES_USER=insta_user
POSTGRES_PASSWORD=insta_pass_2026
POSTGRES_DB=insta_db
POSTGRES_PORT=5456
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+asyncpg://insta_user:insta_pass_2026@postgres:5432/insta_db
