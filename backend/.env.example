# Copie para .env e preencha (opcional). Se definido, não precisa digitar no front.
APIFY_TOKEN=
IG_TOKEN=
FB_TOKEN=
IG_USER_ID=

# Configurações do Pipeline Multi-Actor Apify (opcional)
# APIFY_ACTOR=apify/instagram-scraper
# APIFY_COMMENTS_ACTOR=apify/instagram-comments-scraper
# APIFY_STORIES_ACTOR=goat255/instagram-stories-highlights-scraper
# APIFY_HIGHLIGHTS_ACTOR=goat255/instagram-stories-highlights-scraper
# APIFY_ACTOR_TIMEOUT_SECS=90
# APIFY_TIMEOUT_SECS=120

# Configurações de Inteligência Artificial (Opcional)
# AI_PROVIDER: "gemini" (padrão se GEMINI_API_KEY estiver preenchido), "openai", "openrouter" ou "ollama"
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Fallback de Resiliência para OpenRouter (acionado automaticamente se a IA principal falhar)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Configurações do Banco de Dados PostgreSQL (Resiliência)
POSTGRES_USER=insta_user
POSTGRES_PASSWORD=insta_pass_2026
POSTGRES_DB=insta_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+asyncpg://insta_user:insta_pass_2026@postgres:5432/insta_db


